
pipeline {
    agent any

    stages {
        stage('PULL') {
            steps {
                echo 'GitHub Checkout Success'
            }
        }

        stage('BUILD') {
            steps {
                dir('backend') {
                    sh 'mvn clean package -DskipTests'
                }
                echo 'Build Success'
            }
        }

        stage('TEST') {
            steps {
                dir('backend') {
                    sh 'mvn test'
                }
                echo 'Test Success'
            }
        }

        stage('DEPLOY') {
            steps {
                echo 'Deploy Success'
            }
        }
    }
}
