
pipeline {
    agent any

    stages {

        stage('PULL') {
            steps {
                echo 'GitHub Checkout Success'
            }
        }

        stage('BUILD') {
            steps {
                dir('backend') {
                    sh 'mvn clean package -DskipTests'
                }
                echo 'Build Success'
            }
        }

        stage('TEST') {
            steps {
                echo 'Test Success'
            }
        }

        stage('SONARQUBE ANALYSIS') {
            steps {
                dir('backend') {
                    withSonarQubeEnv('SonarQube') {
                        sh '''
                            mvn org.sonarsource.scanner.maven:sonar-maven-plugin:5.9.0.7382:sonar \
                            -Dsonar.projectKey=pro2 \
                            -Dsonar.projectName=pro2
                        '''
                    }
                }
            }
        }

        stage('QUALITY GATE') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    script {
                        def qg = waitForQualityGate()
                        if (qg.status != 'OK') {
                            error "Quality Gate Failed: ${qg.status}"
                        }
                    }
                }
            }
        }

        stage('DEPLOY') {
            steps {
                echo 'Deploy Success'
            }
        }

    }
}


